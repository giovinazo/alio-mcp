{
  "name": "alio-mcp",
  "version": "1.1.0",
  "description": "MCP server exposing Korea's ALIO public institution disclosure data (한국 공공기관 알리오 항목별공시 MCP) — Node/TypeScript port for MCPB one-click install",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=server/index.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "smoke": "esbuild src/smoke.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/smoke.mjs && node dist/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
